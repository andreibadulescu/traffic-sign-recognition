<Page
    x:Name="DetectSigns"
    x:Class="TrafficSignRecognitionProject.Views.DetectSignsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:models="using:TrafficSignRecognitionProject.Models"
    mc:Ignorable="d">

    <Grid>
        <StackPanel Spacing="30" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.ShowDialogue, Mode=OneWay}" >
            <TextBlock x:Uid="Detect_InitialMessage" Style="{ThemeResource BodyTextStyle}" HorizontalTextAlignment="Center" />
            <Button x:Uid="Detect_SelectButton" Name="DetectSelectButton" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.PickFolderCommand}" CommandParameter="{x:Bind DetectSelectButton}" HorizontalAlignment="Center" />
            <TextBlock x:Name="StatusWindow" Text="{x:Bind ViewModel.ExitMessage, Mode=OneWay}" Visibility="{x:Bind ViewModel.ShowExitMessage, Mode=OneWay}" HorizontalTextAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" />
        </StackPanel>

        <Grid Visibility="{x:Bind ViewModel.ShowResults, Mode=OneWay}" Padding="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,0,0,20">
                <TextBlock x:Uid="Detect_ResultsHeader" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                <Button x:Uid="Detect_SelectOtherFolder" Command="{x:Bind ViewModel.ResetViewCommand}" HorizontalAlignment="Right" Style="{StaticResource SubtleButtonStyle}" />
            </StackPanel>

            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.detectedSigns, Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:SignDetectionResult">
                        <Grid Padding="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{x:Bind Filename}" Grid.Column="0" Style="{ThemeResource BodyTextBlockStyle}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind SymbolName}" Grid.Column="2" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                            <HyperlinkButton x:Uid="Detect_ResultAnnotatedPicture" Grid.Column="4" Command="{Binding ElementName=DetectSigns, Path=ViewModel.OpenAnnotatedCommand}" CommandParameter="{x:Bind ModifiedImage}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
